# Copy this file to .env for local development. Never commit .env.
# Every value below is a placeholder. In the cloud, real values come from
# Google Secret Manager, not from files.
#
# More variables are added here as each service is built.

NODE_ENV=development

# auth-service
AUTH_DB_HOST=localhost
AUTH_DB_NAME=auth
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=

# library-service
LIBRARY_DB_HOST=localhost
LIBRARY_DB_NAME=library
LIBRARY_DB_USER=library_service
LIBRARY_DB_PASSWORD=

# notification-service (local emails are caught by Mailpit, nothing is sent)
SMTP_HOST=localhost
SMTP_PORT=1025
