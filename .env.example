# Copying this file to .env for local development. Never commit .env.
# Every value below is a placeholder. In the cloud, real values come from
# Google Secret Manager, not from files.
# More variables are added here as each service is built.
#Generated secret keys in nodejs using crypto.randomBytes(32).toString('base64url'). Used base64url so it doesnt break the AUTH_MIGRATION_DB_URL because of the characters like "+, / or ="

NODE_ENV=development

# auth-service
AUTH_DB_HOST=localhost
AUTH_DB_NAME=auth
AUTH_DB_PASSWORD=
AUTH_PORT=3001
AUTH_DB_PORT=5432
AUTH_DB_USER=auth_app
AUTH_DB_SUPERUSER_PASSWORD=
AUTH_DB_OWNER_PASSWORD=
AUTH_MIGRATION_DB_URL=postgres://auth_owner:REPLACE_WITH_OWNER_PASSWORD@localhost:5432/auth

# library-service
LIBRARY_DB_HOST=localhost
LIBRARY_DB_NAME=library
LIBRARY_DB_USER=library_service
LIBRARY_DB_PASSWORD=

# notification-service (local emails are caught by Mailpit, nothing is sent)
SMTP_HOST=localhost
SMTP_PORT=1025
